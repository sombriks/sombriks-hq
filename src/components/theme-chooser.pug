mixin theme-chooser()
  //- data/temas.yml
  -
    let themes = temas.themes
  style.
    div.theme-shadow {
      display: flex;
      flex-direction: column;
      margin-top: 0.5rem;
    }

    div.theme-shadow.chooser-active {
      max-height: 16rem;
      overflow-y: auto;
      border-top: 1px dashed var(--text-color);
      padding-top: 0.4rem;
    }

    button.theme-item {
      display: none;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      gap: 0.6ch;
      white-space: nowrap;
      background: transparent;
      border: none;
      color: inherit;
      font-family: inherit;
      font-size: inherit;
      text-align: left;
      padding: 0.15rem 0.25rem;
      cursor: pointer;
      user-select: none;
      width: 100%;
    }

    button.theme-item.active,
    div.theme-shadow.chooser-active button.theme-item {
      display: flex;
    }

    button.theme-item span {
      display: inline-block;
      margin: 0;
      padding: 0;
    }

    button.theme-item:hover,
    div.theme-shadow.chooser-active button.theme-item.active {
      background-color: var(--text-color);
      color: var(--background-color);
    }

    span.theme-check::before {
      content: "[ ]";
    }

    button.theme-item.active span.theme-check::before {
      content: "[*]";
    }

    span.swatch-blocks {
      display: inline-flex !important;
      flex-shrink: 0;
    }

    span.theme-name {
      overflow: hidden;
      text-overflow: ellipsis;
    }

  .theme-shadow
    each t in themes
      button.theme-item(type="button" title=t.name onclick=`chooseTheme("${t.name}")`)
        span.theme-check
        span.swatch-blocks
          span(style=`color: ${t.c0};background-color:${t.c1};`) 🮘
          span(style=`color: ${t.c1};background-color:${t.c0};`) 🮙
        span.theme-name= t.name

  script(type='application/javascript').
    const applyThemeState = name => {
      document.documentElement.dataset.theme = name;
      localStorage.setItem('theme', name);
      document.querySelectorAll('.theme-item').forEach(item => {
        item.classList.toggle('active', item.title === name);
      });
    };

    const initialTheme = localStorage.getItem('theme') || 'stolen from stackoverflow';
    const exists = document.querySelector(`.theme-item[title="${initialTheme}"]`);
    applyThemeState(exists ? initialTheme : document.querySelector('.theme-item').title);

    const chooseTheme = name => {
      const shadow = document.querySelector('.theme-shadow');
      if (shadow.classList.contains('chooser-active')) {
        applyThemeState(name);
        shadow.classList.remove('chooser-active');
      } else {
        shadow.classList.add('chooser-active');
      }
    };
