mixin light-dark()
  style.
    button.light-dark {
      background: transparent;
      border: none;
      color: inherit;
      font-family: inherit;
      font-size: inherit;
      padding: 0;
      margin: 0.25rem 0;
      display: none;
      cursor: pointer;
      user-select: none;
    }

    button.light-dark:hover {
      background-color: var(--text-color);
      color: var(--background-color);
    }

  button.light-dark.light-dark-dark(type="button" onclick="toggleLightDark('dark')") [ ☀ LIGHT ]
  button.light-dark.light-dark-light(type="button" onclick="toggleLightDark('light')") [ ☾ DARK ]

  script(type="application/javascript").
    const toggleLightDark = mode => {
      document.querySelector('.light-dark-dark').style.display = 'inline-block';
      document.querySelector('.light-dark-light').style.display = 'inline-block';
      document.querySelector(`.light-dark-${mode}`).style.display = 'none';
      document.documentElement.dataset.mode = mode;
      localStorage.setItem('mode', mode);
    }

    const tema = e => {
      toggleLightDark(e.matches ? 'dark' : 'light');
    }

    const matchMedia = window.matchMedia('(prefers-color-scheme: dark)');
    matchMedia.onchange = tema;
    const savedMode = localStorage.getItem('mode');
    if (savedMode) toggleLightDark(savedMode);
    else tema(matchMedia);
